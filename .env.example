# === Server FQDN ===
SERVER_NAME=matrix.example.com

# === Tuwunel (Matrix homeserver) ===
TUWUNEL_PORT=6167
TUWUNEL_ALLOW_REGISTRATION=false
# Required when TUWUNEL_ALLOW_REGISTRATION is true. Clients must provide this token to register.
TUWUNEL_REGISTRATION_TOKEN=
TUWUNEL_TRUSTED_SERVERS=["matrix.org"]
TUWUNEL_LOG=warn
# Outgoing HTTP requests, including URL previews; keep local services direct.
# Set to '"none"' to disable the configured proxy.
TUWUNEL_PROXY='{ by_domain = [{ url = "socks5://host.docker.internal:1080", exclude = ["mautrix-telegram", "tuwunel", "localhost", "127.0.0.1"] }] }'
# Max upload file size in bytes (default: 20MB)
# TUWUNEL_MAX_REQUEST_SIZE=20971520
# Enable legacy unauthenticated media endpoints (for clients without authenticated media support)
# TUWUNEL_ALLOW_LEGACY_MEDIA=true
# Allow URL previews for all domains; use [] to disable or list specific domains.
TUWUNEL_URL_PREVIEW_DOMAIN_EXPLICIT_ALLOWLIST='["*"]'
# User-Agent for preview pages; preview media inherits it unless configured separately.
TUWUNEL_URL_PREVIEW_USER_AGENT='Mozilla/5.0 (compatible; Discordbot/2.0; +https://discordapp.com)'
# TURN credentials TTL in seconds (default: 86400 = 24h)
# TUWUNEL_TURN_TTL=86400

# === Telegram bridge proxy ===
# Applied to network.proxy in config.yaml on each container start.
# Set TELEGRAM_PROXY_TYPE=disabled to connect to Telegram directly.
TELEGRAM_PROXY_TYPE=socks5
TELEGRAM_PROXY_ADDRESS=host.docker.internal:1080

# === TURN Server (Coturn) ===
TURN_SECRET=your-secret-here
# Public IP address of the server (required for NAT traversal)
TURN_EXTERNAL_IP=203.0.113.1
# TURN_MIN_PORT=50201
# TURN_MAX_PORT=50400

# === Traefik ===
ACME_EMAIL=admin@example.com

# Уровень логирования Traefik: DEBUG, INFO, WARN, ERROR, FATAL, PANIC
TRAEFIK_LOG_LEVEL=ERROR
