# Исходный Tuwunel-сервер. Приватный ключ хранится только на backup-сервере.
SOURCE_HOST=matrix.example.com
SOURCE_USER=tuwunel-backup
SSH_PORT=22
SSH_IDENTITY_FILE=/var/lib/borg/.ssh/tuwunel-backup

# Фактический Source для mount /var/lib/tuwunel из `docker inspect tuwunel`.
SOURCE_DATA_PATH=/var/lib/docker/volumes/tuwunel-docker_data/_data
SOURCE_CONFIG_PATH=/opt/tuwunel-docker

# Локальные каталоги на backup-сервере.
STAGING_DIR=/var/lib/borg/staging/tuwunel
BORG_REPO=/var/lib/borg/repositories/tuwunel

# Предпочтительно хранить пароль в отдельном файле с правами 0600:
BORG_PASSCOMMAND="cat /var/lib/borg/secrets/tuwunel-passphrase"
# Альтернатива:
# BORG_PASSPHRASE=change-me

MIN_CHECKPOINT_AGE=1800
BORG_COMPRESSION=lz4
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
